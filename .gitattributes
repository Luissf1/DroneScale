# Normalize line endings across platforms.
# Checkout: convert to native line ending.
# Commit: store as LF (Linux-style) internally.
* text=auto eol=lf

# Python source files
*.py text eol=lf

# Markdown, YAML, JSON, LaTeX
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.tex text eol=lf

# Config files
*.cfg text eol=lf
*.toml text eol=lf
*.ini text eol=lf

# Windows scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.pt binary
*.pth binary